# Function using 1 iteration
def multiply_one_iteration(a, b):
    return a * b

# Function using N iterations
def multiply_n_iterations(a, b):
    result = 0
    for i in range(b):
        result = result + a
    return result


# Taking input
a = int(input("Enter 'a' for a*b : "))
b = int(input("Enter 'b' for a*b : "))

# Calling functions
one_iter = multiply_one_iteration(a, b)
n_iter = multiply_n_iterations(a, b)

# Output
print("\n1 iteration:", one_iter)
print("N iteration:", n_iter)