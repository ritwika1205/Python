import tkinter as tk
import random

# Generate random number
number = random.randint(1, 100)

# Function to check the guess
def check_guess():
    guess = int(entry.get())

    if guess < number:
        result_label.config(text="Too Low! Try again.")
    elif guess > number:
        result_label.config(text="Too High! Try again.")
    else:
        result_label.config(text="Correct! You guessed the number.")

# Create window
window = tk.Tk()
window.title("Guess The Number Game")
window.geometry("300x200")

# Title
title = tk.Label(window, text="Guess a number (1-100)")
title.pack(pady=10)

# Entry box
entry = tk.Entry(window)
entry.pack(pady=5)

# Button
guess_button = tk.Button(window, text="Submit Guess", command=check_guess)
guess_button.pack(pady=5)

# Result label
result_label = tk.Label(window, text="")
result_label.pack(pady=10)

# Run window
window.mainloop()