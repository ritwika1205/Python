num1 = int(input("Enter first number: "))
num2 = int(input("Enter second number: "))
numberLargest = num1
numberSmallest = num2
while numberSmallest != 0:
    numberStore = numberSmallest
    numberSmallest = numberLargest % numberSmallest
    numberLargest = numberStore
hcf = numberLargest
lcm = (num1 * num2) // hcf
print("LCM is:", lcm)